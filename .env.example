# From Discord Developer Portal -> Your Application -> Bot -> Reset Token.
# This is a secret and must never be committed or shared.
DISCORD_TOKEN=your-discord-bot-token

# Optional: right-click your Discord server -> Copy Server ID.
# Enable Developer Mode in Discord settings first. Leave blank for global commands.
DISCORD_GUILD_ID=

# Optional: create an app at https://developer.spotify.com/dashboard.
# Open the app's Settings to find the Client ID and Client Secret.
# Without these values, /play falls back to a YouTube search.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Kept for future prefix-command support; current commands are slash commands.
BOT_PREFIX=!

# Maximum number of waiting tracks per Discord server.
MAX_QUEUE_SIZE=50
